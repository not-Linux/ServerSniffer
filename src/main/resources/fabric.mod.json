{
  "schemaVersion": 1,
  "id": "serversniffer",
  "version": "${version}",
  "name": "ServerSniffer",
  "description": "Meteor addon that reads server packets to reveal plugins, software, anticheat & everything about the server.",
  "authors": ["ServerSniffer"],
  "license": "MIT",
  "icon": "assets/serversniffer/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.serversniffer.ServerSnifferAddon"
    ]
  },
  "mixins": [
    "serversniffer.mixins.json"
  ],
  "accessWidener": "serversniffer.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric": "*",
    "java": ">=25",
    "minecraft": "26.2",
    "meteor-client": "*"
  }
}
